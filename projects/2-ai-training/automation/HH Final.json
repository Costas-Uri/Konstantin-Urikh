    {
      "parameters": {
        "jsCode": "// Извлекаем все ID вакансий из HTML письма\nconst html = $input.first().json.textHtml;\nconst vacancyIds = [];\n\n// Регулярное выражение для поиска ссылок на вакансии\nconst regex = /hh\\.ru\\/vacancy\\/(\\d+)/g;\nlet match;\n\nwhile ((match = regex.exec(html)) !== null) {\n  vacancyIds.push(match[1]);\n}\n\n// Удаляем дубликаты\nconst uniqueIds = [...new Set(vacancyIds)];\n\n// Возвращаем массив объектов с ID вакансий\nreturn uniqueIds.map(id => ({\n  json: {\n    vacancy_id: id,\n    message_id: $input.first().json['message-id'],\n    subject: $input.first().json.subject,\n    html: html\n  }\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        560
      ],
      "id": "19488876-215c-47db-a005-24d70cbd9c3e",
