    {
      "parameters": {
        "jsCode": "const emailItem = $input.first();\nconst rawEmailText = emailItem.json.description || emailItem.json.html || emailItem.json.text || '';\nconst subject = emailItem.json.subject || '';\nconst date = emailItem.json.date || new Date().toISOString();\n\n// 1. Извлекаем ID вакансии из URL в письме\nconst vacancyMatch = rawEmailText.match(/hh\\.ru\\/vacancy\\/(\\d+)/);\nconst vacancyId = vacancyMatch ? vacancyMatch[1] : '';\n\n// 2. Функция для жесткой очистки HTML от мусора\nfunction cleanHtml(html) {\n  if (!html) return '';\n  return html\n    // Удаляем блоки скриптов и стилей целиком (они самые тяжелые)\n    .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n    .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n    // Удаляем все остальные HTML-теги\n    .replace(/<[^>]+>/g, ' ')\n    // Заменяем HTML-сущности\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>')\n    // Схлопываем множественные пробелы и переносы строк в один пробел\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nconst cleanText = cleanHtml(rawEmailText);\n\n// 3. Извлекаем суть ответа. \n// Берем 1500 символов чистого текста после приветствия. Этого хватит, чтобы понять: приглашение, отказ или уточнение.\nconst responseMatch = cleanText.match(/(?:Здравствуйте|Добрый день|Уважаемый|Коллеги|Доброе утро)[\\s\\S]{0,1500}/i);\nconst responseText = responseMatch ? responseMatch[0].trim() : cleanText.substring(0, 1500);\n\nreturn {\n  json: {\n    vacancy_id: vacancyId,\n    response_date: date,\n    email_subject: subject,\n    // В LLM передаем ТОЛЬКО этот чистый, короткий текст\n    email_body_clean: responseText,\n    // На всякий случай сохраняем чуть больше чистого текста, если понадобится для отладки\n    full_clean_text: cleanText.substring(0, 3000) \n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        896
      ],
