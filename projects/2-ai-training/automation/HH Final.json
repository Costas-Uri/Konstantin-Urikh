      "id": "bc2917c5-f133-46c1-838d-25b4d306fce3",
      "name": "HTML"
    },
    {
      "parameters": {
        "jsCode": "// 1. Получаем текст письма и дату СТРОГО из предыдущей ноды (Switch)\nconst inputItem = $input.first();\nconst description = inputItem.json.description || inputItem.json.html || inputItem.json.text || '';\nconst lines = description.split('\\n');\n\n// 2. Берем дату из ноды Switch (первый item, так как все вакансии из одного письма)\nlet formattedDate = 'Дата не найдена';\n\ntry {\n  const switchData = $('Switch').first(); // Берем ПЕРВЫЙ item из Switch\n  const rawDate = switchData.json.date;\n\n  if (rawDate) {\n    const dateObj = new Date(rawDate);\n    if (!isNaN(dateObj.getTime())) {\n      const parts = dateObj.toLocaleString('en-CA', { \n        timeZone: 'Europe/Simferopol',\n        year: 'numeric', month: '2-digit', day: '2-digit',\n        hour: '2-digit', minute: '2-digit', hour12: false\n      }).split(', ');\n      formattedDate = `${parts[0]} ${parts[1]}`;\n    } else {\n      formattedDate = `Ошибка парсинга: ${rawDate}`;\n    }\n  }\n} catch (e) {\n  formattedDate = `Ошибка: ${e.message}`;\n}\n// 3. Инициализируем массив результатов и Set для уникальных ID\nconst vacancies = [];\nconst seenUrls = new Set();\nconst urlRegex = /https:\\/\\/hh\\.ru\\/vacancy\\/(\\d+)/g;\nlet match;\n\nwhile ((match = urlRegex.exec(description)) !== null) {\n  const vacancyId = match[1];\n  \n  if (seenUrls.has(vacancyId)) continue;\n  seenUrls.add(vacancyId);\n\n  let title = '';\n  let salary = 'Не указана';\n  let company = '';\n  let location = '';\n  let isRemote = false;\n\n  for (let i = 0; i < lines.length; i++) {\n    if (lines[i].includes(`vacancy/${vacancyId}`)) {\n      \n      // --- Ищем НАЗВАНИЕ (смотрим 1-3 строки НАЗАД) ---\n      for (let j = i - 1; j >= Math.max(0, i - 4); j--) {\n        const prev = lines[j].trim();\n        if (prev && \n            !prev.includes('hh.ru') && \n            !prev.includes('Посмотреть') && \n            !prev.includes('Новые вакансии') && \n            !prev.includes('От проверенных')) {\n          title = prev;\n          break;\n        }\n      }\n\n      // --- Ищем ЗП, КОМПАНИЮ и ЛОКАЦИЮ (смотрим до 6 строк ВПЕРЁД) ---\n      let foundCompany = false;\n      for (let j = i + 1; j < Math.min(lines.length, i + 8); j++) {\n        const next = lines[j].trim();\n        \n        if (next.includes('Посмотреть вакансию') || next.includes('hh.ru/vacancy')) {\n          break;\n        }\n        if (!next) continue;\n\n        if (next.includes('Можно удалённо') || next.includes('Можно удаленно')) {\n          isRemote = true;\n          continue;\n        }\n\n        if (!foundCompany && (next.includes('₽') || next.includes('$') || next.includes('€') || next.includes('за месяц') || next.includes('за день') || next.includes('от ') || next.includes('до '))) {\n          salary = next;\n          continue;\n        }\n\n        if (!foundCompany) {\n          company = next;\n          foundCompany = true;\n        } else if (!location) {\n          location = next;\n          break;\n        }\n      }\n      break;\n    }\n  }\n\n  if (vacancyId && title) {\n    vacancies.push({\n      json: {\n        Date: formattedDate,\n        Vacancy_ID: vacancyId,\n        Vacancy_Title: title,\n        Vacancy_URL: `https://hh.ru/vacancy/${vacancyId}`,\n        Salary: salary,\n        Company: company,\n        Status: 'New'          \n      }\n    });\n  }\n}\n\nconsole.log(`Успешно извлечено уникальных вакансий: ${vacancies.length}`);\nreturn vacancies;"
      },
