        832,
        656
      ],
      "id": "1899319a-aec8-4d30-8826-0bcf37c29b55",
      "name": "Code (count)"
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.sheetWrites = (staticData.sheetWrites || 0) + 1;\n\nreturn [{\n  json: {\n    ...$input.first().json,\n    sheetWrites: staticData.sheetWrites\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        800
      ],
      "id": "7ad8a011-1593-404e-9b27-05f14b92aaba",
      "name": "Code (cycle)"
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst results = [];\n\nfor (const emailItem of allItems) {\n  // ИСПРАВЛЕНО: добавлено textHtml\n  const rawEmailText = emailItem.json.textHtml || emailItem.json.description || emailItem.json.html || emailItem.json.text || '';\n  const subject = emailItem.json.subject || '';\n  const date = emailItem.json.date || new Date().toISOString();\n\n  // 1. Извлекаем ID вакансии из URL в письме\n  const vacancyMatch = rawEmailText.match(/hh\\.ru\\/vacancy\\/(\\d+)/);\n  const vacancyId = vacancyMatch ? vacancyMatch[1] : '';\n\n  // 2. Функция для очистки HTML\n  function cleanHtml(html) {\n    if (!html) return '';\n    return html\n      .replace(/<script\\b[^<]*(?:(?!<\\/script>)<[^<]*)*<\\/script>/gi, '')\n      .replace(/<style\\b[^<]*(?:(?!<\\/style>)<[^<]*)*<\\/style>/gi, '')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/&nbsp;/g, ' ')\n      .replace(/&/g, ' &')\n      .replace(/</g, ' <')\n      .replace(/>/g, ' >')\n      .replace(/\\s+/g, ' ')\n      .trim();\n  }\n\n  const cleanText = cleanHtml(rawEmailText);\n\n  // 3. ИСПРАВЛЕНО: расширенный паттерн для поиска текста\n  // Ищет не только приветствия, но и ключевые фразы отказов/приглашений\n  const responseMatch = cleanText.match(/(?:Работодатель не готов|Вакансия:|Компании:|Здравствуйте|Добрый день|Уважаемый|Коллеги|Доброе утро|Мы рассмотрели|Приглашаем)[\\s\\S]{0,1500}/i);\n  const responseText = responseMatch ? responseMatch[0].trim() : cleanText.substring(0, 1500);\n\n  results.push({\n    json: {\n      vacancy_id: vacancyId,\n      response_date: date,\n      email_subject: subject,\n      email_body_clean: responseText,\n      full_clean_text: cleanText.substring(0, 3000),\n      original_message_id: emailItem.json['message-id'] || emailItem.json.metadata?.['message-id'] || ''\n    }\n  });\n}\n\nconsole.log(`Обработано писем: ${results.length}`);\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        1056
      ],
      "id": "5fea3641-e1c2-4146-8c3d-5602c0545f8c",
      "name": "Code (not vacancy)"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (const item of items) {\n  // Всегда перекодируем textHtml\n  if (item.json.textHtml) {\n    item.json.textHtml = Buffer.from(item.json.textHtml, 'latin1').toString('utf8');\n  }\n  \n  // Всегда перекодируем textPlain\n  if (item.json.textPlain) {\n    item.json.textPlain = Buffer.from(item.json.textPlain, 'latin1').toString('utf8');\n  }\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        944
      ],
      "id": "f4efabb7-c39a-4cd1-be9b-70feaf1912f9",
      "name": "Code (initial letter)"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst vacancies = [];\n\nfor (const item of items) {\n  const html = item.json.textHtml || item.json.html || '';\n  const rawDate = item.json.date || new Date().toISOString();\n  const messageId = item.json['message-id'] || item.json.metadata?.['message-id'] || '';\n  const subject = item.json.subject || '';\n  \n  if (!html) continue;\n\n  // Извлекаем все ID вакансий из HTML\n  const regex = /hh\\.ru\\/vacancy\\/(\\d+)/g;\n  let match;\n  const vacancyIds = [];\n  \n  while ((match = regex.exec(html)) !== null) {\n    if (!vacancyIds.includes(match[1])) {\n      vacancyIds.push(match[1]);\n    }\n  }\n\n  // Обрабатываем каждую вакансию\n  for (const vacancyId of vacancyIds) {\n    // 1. Форматируем дату\n    let formattedDate = 'Дата не найдена';\n    try {\n      const dateObj = new Date(rawDate);\n      if (!isNaN(dateObj.getTime())) {\n        const parts = dateObj.toLocaleString('en-CA', { \n          timeZone: 'Europe/Simferopol',\n          year: 'numeric', month: '2-digit', day: '2-digit',\n          hour: '2-digit', minute: '2-digit', hour12: false\n        }).split(', ');\n        formattedDate = `${parts[0]} ${parts[1]}`;\n      }\n    } catch (e) {}\n\n    // 2. Ищем название вакансии (текст внутри ссылки с нужным ID)\n    const titleRegex = new RegExp(`<a[^>]*href=\"[^\"]*vacancy/${vacancyId}[^\"]*\"[^>]*>([^<]+)</a>`, 'i');\n    const titleMatch = html.match(titleRegex);\n    const title = titleMatch ? titleMatch[1].trim() : 'Название не найдено';\n\n    let salary = 'Не указана';\n    let company = '';\n    let isRemote = false;\n\n    if (titleMatch && titleMatch.index !== undefined) {\n      // Берем кусок HTML после ссылки (2500 символов достаточно)\n      const htmlAfterLink = html.substring(titleMatch.index, titleMatch.index + 2500);\n\n      // 3. Ищем зарплату (блок с классом \"salary\")\n      const salaryRegex = /<td[^>]*class=\"[^\"]*salary[^\"]*\"[^>]*>([\\s\\S]*?)<\\/td>/i;\n      const salaryMatch = htmlAfterLink.match(salaryRegex);\n      if (salaryMatch) {\n        salary = salaryMatch[1]\n          .replace(/<[^>]+>/g, '')\n          .replace(/ /g, ' ')\n          .replace(/\\s+/g, ' ')\n          .trim();\n      }\n\n      // 4. Ищем компанию (первый параграф с классом \"paragraph\" после ссылки)\n      const companyRegex = /<p[^>]*class=\"[^\"]*paragraph[^\"]*\"[^>]*>([^<]+)<\\/p>/i;\n      const companyMatch = htmlAfterLink.match(companyRegex);\n      if (companyMatch) {\n        company = companyMatch[1].trim();\n      }\n\n      // 5. Проверяем на удаленку\n      const lowerHtml = htmlAfterLink.toLowerCase();\n      isRemote = lowerHtml.includes('можно удалённо') || \n                 lowerHtml.includes('можно удаленно') ||\n                 lowerHtml.includes('remote') ||\n                 lowerHtml.includes('удалённ') ||\n                 lowerHtml.includes('удаленн') ||\n                 lowerHtml.includes('дистанционно');\n    }\n\n    vacancies.push({\n      json: {\n        Date: formattedDate,\n        Vacancy_ID: vacancyId,\n        Vacancy_Title: title,\n        Vacancy_URL: `https://hh.ru/vacancy/${vacancyId}`,\n        Salary: salary,\n        Company: company,\n        isRemote: isRemote,\n        Status: 'New',\n        message_id: messageId,\n        subject: subject\n      }\n    });\n  }\n}\n\nconsole.log(`Успешно распарсено вакансий: ${vacancies.length}`);\nreturn vacancies;"
      },
