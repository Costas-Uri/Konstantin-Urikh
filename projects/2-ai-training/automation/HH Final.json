    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst totalLoops = $input.all().length;\nconst sheetWrites = staticData.sheetWrites || 0;\n\n// Сбрасываем счётчик для следующего запуска\nstaticData.sheetWrites = 0;\n\nreturn [{\n  json: {\n    totalLoops: totalLoops,\n    sheetWrites: sheetWrites,\n    notWritten: totalLoops - sheetWrites\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
