              "key": "vacancy_title",
              "cssSelector": "a[href*=\"hh.ru/vacancy/\"]"
            },
            {
              "key": "salary",
              "cssSelector": ".salary ИЛИ [class*=\"salary\"] ИЛИ .compensation"
            },
            {
              "key": "description",
              "cssSelector": "body",
              "skipSelectors": "img, .header, .footer, .unsubscribe"
            },
            {
              "key": "vacancy_url",
              "cssSelector": "a[href*=\"hh.ru/vacancy/\"]",
              "returnValue": "attribute",
              "attribute": "href"
            }
          ]
        },
        "options": {}
