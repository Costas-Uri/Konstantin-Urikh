      "parameters": {
        "jsCode": "// Получаем данные от LLM-Classification\nconst LLM1 = $('LLM-Classification').first().json;\n\n// Получаем данные от Code1\nconst code1 = $('Code1').first().json;\n\n// В LLM1 поле text переименовываем в category\nconst category = LLM1.text || LLM1.category || '';\n\n// Формируем объединённый объект\nconst merged = {\n  category: category,\n  row_number: code1.row_number,\n  session_id: code1.session_id,\n  source_id: code1.source_id,\n  user_id: code1.user_id,\n  started_at: code1.started_at,\n  chatInput: code1.chatInput\n};\n\nreturn [merged];"
      },
